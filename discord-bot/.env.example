# ── Discord ──────────────────────────────────────────────────────
DISCORD_TOKEN=ton_bot_token_ici
DISCORD_CLIENT_ID=ton_client_id_ici

# Guild ID = ID de ton serveur Discord (pour les commandes instantanées en dev)
# Retire cette variable en prod pour passer les commandes en global
DISCORD_GUILD_ID=id_de_ton_serveur

# Channel où poster les notifs d'activité (uploads, tournois...)
DISCORD_NOTIF_CHANNEL_ID=id_du_channel_notifs

# Channel de bienvenue pour les nouveaux membres
DISCORD_WELCOME_CHANNEL_ID=id_du_channel_bienvenue

# Rôle à assigner automatiquement aux nouveaux membres
DISCORD_MEMBER_ROLE_ID=id_du_role_membre

# ── Supabase ──────────────────────────────────────────────────────
# Utiliser la service_role key (pas l'anon key) pour lire toutes les données
SUPABASE_URL=https://ton-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ta_service_role_key_ici
